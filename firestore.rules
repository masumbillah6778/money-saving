rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "masumbillah6778@gmail.com";
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.gmail == request.auth.token.email
        && request.resource.data.status == "active"
        && request.resource.data.memberId.matches("^6778[0-9]{4}$");

      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.gmail == resource.data.gmail
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["name", "updatedAt"])
        );

      allow delete: if isAdmin();
    }

    match /deposits/{depositId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active"
        && request.resource.data.memberId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberId
        && request.resource.data.gmail == request.auth.token.email
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update, delete: if isAdmin();
    }
  }
}
